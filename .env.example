# Medical Notes Helper configuration
# Copy this file to .env and never commit .env to git.

# N-gram model defaults
NGRAM_ORDER=3
DEFAULT_SMOOTHING=kneser_ney
DEFAULT_TOP_K=5

# Local persistence for feedback, custom phrases, and saved drafts
NOTES_STORAGE_PATH=.medical_notes_data.json

# Optional LLM provider for note polishing (core n-gram predictor works 100% offline)
# Choose one of: none, ollama, groq, gemini
LLM_PROVIDER=none

# Option 1: Local Ollama (free, runs on your laptop)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Option 2: Groq API (free tier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Option 3: Google Gemini API (free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
